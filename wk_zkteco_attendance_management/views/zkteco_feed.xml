<odoo>
    <data>
        <record id="view_zkteco_attendance_feed_tree" model="ir.ui.view">
            <field name="name">zkteco.attendance.feed.tree</field>
            <field name="model">zkteco.attendance.feed</field>
            <field name="arch" type="xml">
                <list default_order="id desc" string="ZKTeco Devices">
                    <field name="employee_id"/>
                    <field name="name" string="Badge ID"/>
                    <field name="timestamp"/>
                    <field name="device_id" string="Device"/>
                    <field name="state"  widget="badge" string="State" decoration-info="state == 'new'"  decoration-success="state == 'mark'"/>
                    <field name="attendance_id" optional="hide"/>
                     <field name="attendance_mark_type" string="Attendance Type"  optional="hide"/>
                    <field name="create_date" optional="hide"/>
                    <field name="write_date" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="zkteco_feed_filter" model="ir.ui.view">
            <field name="name">zkteco.feed.search</field>
            <field name="model">zkteco.attendance.feed</field>
            <field name="arch" type="xml">
                <search string="Feed Search">
                    <field name="employee_id"/>
                    <field name="name" string="Badge ID"/>
                    <group expand="0" string="Group By">
                        <filter string="Employee" name="employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="State" name="state" context="{'group_by': 'state'}"/>
                        <filter string="Device" name="device_id" context="{'group_by': 'device_id'}"/>
                        <filter string="Attendance Type" name="attendance_mark_type" context="{'group_by': 'attendance_mark_type'}"/>
                    </group>
                </search>
            </field>
        </record>
    
        <record id="view_zkteco_attendance_feed_form" model="ir.ui.view">
            <field name="name">zkteco.attendance.feed.form</field>
            <field name="model">zkteco.attendance.feed</field>
            <field name="arch" type="xml">
                <form string="ZKTeco Feeds">
                    <header>
                        <button string="Mark Attendance" type="object" name="create_attendance" class="btn-primary" invisible="state == 'mark'" />
                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id" readonly="state == 'mark'" invisible="not employee_id"/>
                                <field name="name" readonly="state == 'mark'" string="Employee Badge"/>
                                <field name="device_id" string="Device" readonly="state == 'mark'" domain="[('state','=', 'connected')]"/>
                                <field name="attendance_mark_type" readonly="state == 'mark'" string="Attendance Type" invisible="not attendance_mark_type"/>
                            </group>
                            <group>
                                <field name="timestamp" readonly="state == 'mark'"/>
                                <field name="punch_state_data" readonly="state == 'mark'" />
                                <field name="attendance_id" readonly="state == 'mark'" invisible="not attendance_id"/>
                                <field name="sid" invisible="1" />
                            </group>
                        </group>
                        <footer>
                           
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>