<odoo>
    <record id="sale_order_search_team_town_filter" model="ir.ui.view">
        <field name="name">sale.order.search.team.town.filter</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='team_id']" position="after">
                <field name="delivery_town_id"/>
            </xpath>

            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <filter name="my_team_town_orders"
                        string="My Team Town Orders"
                        domain="[('user_team_town_match', '=', True)]"/>
            </xpath>

            <xpath expr="//search/group[1]" position="inside">
                <filter name="group_by_team"
                        string="Sales Team"
                        context="{'group_by': 'team_id'}"/>
                <filter name="group_by_delivery_town"
                        string="Delivery Town"
                        context="{'group_by': 'delivery_town_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
