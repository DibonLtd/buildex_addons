<odoo>
    <record id="sale_order_form_delivery_town" model="ir.ui.view">
        <field name="name">sale.order.form.delivery.town</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="delivery_town_id" readonly="1"/>
                <field name="payment_preference" readonly="1"/>
                <field name="bank_till_payment_reference" readonly="1"/>
            </xpath>
            <!-- Technician info tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Technician Info" name="technician_info">
                    <group>
                        <field name="technician_name"/>
                        <field name="technician_contact"/>
                        <field name="technician_location"/>
                    </group>
                    <group>
                        <field name="technician_specs" nolabel="1" placeholder="Installation specifications..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
