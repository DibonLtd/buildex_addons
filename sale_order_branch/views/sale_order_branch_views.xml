<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_branch_list" model="ir.ui.view">
        <field name="name">sale.order.branch.list</field>
        <field name="model">sale.order.branch</field>
        <field name="arch" type="xml">
            <list string="Branches">
                <field name="name"/>
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="sale_order_count"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sale_order_branch_form" model="ir.ui.view">
        <field name="name">sale.order.branch.form</field>
        <field name="model">sale.order.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sales Orders">
                            <field name="sale_order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_order"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_order_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">sale.order.branch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_sale_order_branch"
        name="Branches"
        parent="sale.menu_sales_config"
        action="action_sale_order_branch"
        sequence="35"
    />
</odoo>
