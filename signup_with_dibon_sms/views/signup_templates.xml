<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Inherit the signup template to add the mobile number signup link-->
    <template id="signup_with_mobile_link" inherit_id="auth_signup.signup"
              name="Signup with mobile link">
        <xpath expr="//button[@type='submit']" position="after">
            <div class="justify-content-between mt-2 d-flex small signup-link">
                <a class="sign-up-mobile" style="font-size: 12px;"
                   t-attf-href="/web/signup-mobile?{{ keep_query() }}">SignUp
                    With Mobile
                </a>
            </div>
        </xpath>
    </template>
    <!-- ── Step 1: mobile + email form ───────────────────── -->
    <template id="mobile_signup_step1" name="Mobile Signup Step 1">
        <t t-call="web.login_layout">
            <div style="max-width:420px;margin:0 auto;">
                <h4 class="fw-bold mb-1" style="color:#1e293b;">Create Account</h4>
                <p class="text-muted mb-4" style="font-size:.88rem;">Enter your mobile number to get started</p>

                <t t-if="error and not show_mobile_registered_popup">
                    <p class="alert alert-danger py-2 px-3" style="font-size:.88rem;" role="alert">
                        <t t-esc="error"/>
                    </p>
                </t>

                <!-- Mobile already registered popup -->
                <t t-if="show_mobile_registered_popup">
                    <div id="blx-mobile-taken-overlay"
                         style="position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:9999;display:flex;align-items:center;justify-content:center;">
                        <div style="background:#fff;border-radius:16px;padding:32px 28px;max-width:360px;width:90%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.25);">
                            <div style="font-size:2.4rem;margin-bottom:12px;">&#128245;</div>
                            <h5 class="fw-bold mb-2" style="color:#1e293b;">Mobile Already Registered</h5>
                            <p style="color:#64748b;font-size:.9rem;margin-bottom:24px;">
                                This mobile number already has an account.<br/>Please log in instead.
                            </p>
                            <a href="/web/login" class="btn btn-primary w-100 mb-2 fw-semibold">Log In</a>
                            <button type="button" class="btn btn-outline-secondary w-100"
                                    onclick="document.getElementById('blx-mobile-taken-overlay').style.display='none'">
                                Use a Different Number
                            </button>
                        </div>
                    </div>
                </t>

                <form method="post" action="/mobile/signup/send-otp">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <!-- Mobile number -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size:.88rem;">Mobile Number <span style="color:#dc2626;">*</span></label>
                        <div class="d-flex gap-2">
                            <select name="country_code" class="form-select form-select-sm" style="width:90px;flex-shrink:0;">
                                <option value="254" selected="selected">+254</option>
                            </select>
                            <input type="tel" name="login_mobile"
                                   class="form-control form-control-sm"
                                   placeholder="0712345678"
                                   required="required"
                                   autocomplete="tel"
                                   autofocus="autofocus"/>
                        </div>
                    </div>

                    <!-- Email (optional) -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold" style="font-size:.88rem;">Email <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="email" name="email"
                               class="form-control form-control-sm"
                               placeholder="e.g. john@example.com"
                               autocomplete="email"/>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary fw-semibold">
                            Send OTP &#8594;
                        </button>
                    </div>
                    <div class="text-center mt-3">
                        <a href="/web/login" class="text-muted" style="font-size:.83rem;">Already have an account? Log in</a>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <!-- ── Step 3: OTP verification ──────────────────────── -->
    <template id="mobile_signup_verify" name="Mobile Signup OTP Verify">
        <t t-call="web.login_layout">
            <div style="max-width:420px;margin:0 auto;">
                <h4 class="fw-bold mb-1" style="color:#1e293b;">Verify OTP</h4>
                <p class="text-muted mb-4" style="font-size:.88rem;">
                    We sent a 4-digit code to <strong><t t-esc="mobile"/></strong>
                </p>

                <t t-if="error">
                    <p class="alert alert-danger py-2 px-3" style="font-size:.88rem;" role="alert">
                        <t t-esc="error"/>
                    </p>
                </t>

                <form method="post" action="/mobile/signup/verify">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-4">
                        <label class="form-label fw-semibold" style="font-size:.88rem;">Enter OTP</label>
                        <input type="text" name="otp"
                               class="form-control text-center"
                               style="font-size:1.4rem;letter-spacing:.4rem;"
                               placeholder="----"
                               maxlength="4"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               autofocus="autofocus"
                               required="required"/>
                    </div>
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary fw-semibold">Verify &amp; Continue</button>
                    </div>
                </form>

                <form method="post" action="/mobile/signup/resend-otp">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="text-center">
                        <button type="submit" class="btn btn-link btn-sm text-muted p-0" style="font-size:.83rem;">
                            Didn&#39;t receive it? Resend OTP
                        </button>
                    </div>
                </form>

                <div class="text-center mt-2">
                    <a href="/mobile/signup" class="text-muted" style="font-size:.83rem;">&#8592; Change mobile number</a>
                </div>
            </div>
        </t>
    </template>

    <!--    Template for signup with mobile -->
    <template id="signup_with_mobile_fields"
              name="Auth Signup with mobile form fields">

        <!-- Mobile section: hidden when OTP already verified (mobile came from Step 1) -->
        <t t-if="not otp_verified">
            <div class="mb-3 field-login-mobile">
                <label for="login_mobile">Mobile Number</label>
                <div class="country-and-mobile-number">
                    <div class="mb-1 field-phone col-lg-3" id="country_code">
                        <select class="div_code" name="country_code"
                                style="background-color: white">
                            <option value="254" selected="selected">+254</option>
                        </select>
                    </div>
                    <div class="mb-1 field-phone col-lg-9" id="div_number">
                        <input type="text" name="login_mobile"
                               t-att-value="login_mobile"
                               class="login_mobile form-control form-control-sm"
                               placeholder="0712345678"
                               autofocus="autofocus" autocapitalize="off"
                               required="required"
                               t-att-readonly="'readonly' if only_passwords else None"/>
                    </div>
                </div>
            </div>
            <div class="otp-verification">
                <label for="otp_verify">OTP Verification</label>
                <div class="mb-3 otp_verify"
                     style="display: flex; flex-direction: row;">
                    <div class="mb-1 sms-validate col-lg-6">
                        <input type="text" name="sms_otp" t-att-value="sms_otp"
                               id="sms_otp_verify"
                               class="form-control" autofocus="autofocus"
                               required="required"
                               style="height: 32px; margin-right:5px;"/>
                    </div>
                    <button name="sent_otp_sms"
                            style="height: 32px; margin-left:5px; border-radius: 20px; padding-bottom: 27px"
                            class="btn btn-primary sent-otp col-lg-6"
                            role="button">Send OTP
                    </button>
                </div>
            </div>
            <div class="mb-3 field-signup-email">
                <label for="signup_email">Email <span class="text-muted fw-normal" style="font-size:.85em;">(optional)</span></label>
                <input type="email" name="signup_email" id="signup_email"
                       class="form-control form-control-sm"
                       placeholder="e.g. john@example.com"
                       autocapitalize="off"/>
            </div>
        </t>
        <t t-else="">
            <!-- OTP already verified — pass mobile and login as hidden inputs -->
            <input type="hidden" name="country_code" t-att-value="prefilled_country_code or '254'"/>
            <input type="hidden" name="login_mobile" t-att-value="prefilled_mobile_raw or ''"/>
            <input type="hidden" name="signup_email" t-att-value="signup_email or ''"/>
            <!-- Show verified mobile as a read-only badge -->
            <div class="mb-3">
                <div class="d-flex align-items-center gap-2 p-2 rounded" style="background:#f0fdf4;border:1px solid #bbf7d0;">
                    <span style="color:#166534;font-size:.85rem;">&#9989; Mobile verified:</span>
                    <span class="fw-semibold" style="color:#166534;font-size:.9rem;">
                        +<t t-esc="prefilled_country_code or '254'"/>&#160;<t t-esc="prefilled_mobile_raw or ''"/>
                    </span>
                </div>
            </div>
        </t>

        <div class="mb-3 field-name">
            <label for="name">Your Name</label>
            <input type="text" name="name" t-att-value="name" id="name"
                   class="form-control form-control-sm"
                   placeholder="e.g. John Doe"
                   required="required"
                   t-att-readonly="'readonly' if only_passwords else None"
                   t-att-autofocus="'autofocus' if login and not only_passwords else None"/>
        </div>
        <div class="mb-3 field-delivery-town">
            <label for="default_delivery_town_id">Home Town</label>
            <select id="default_delivery_town_id"
                    name="default_delivery_town_id"
                    class="form-control form-control-sm">
                <option value="">Select delivery town...</option>
                <t t-foreach="available_delivery_towns" t-as="town">
                    <option t-att-value="town.id"
                            t-att-selected="str(town.id) == str(default_delivery_town_id or '')">
                        <t t-esc="town.name"/>
                    </option>
                </t>
            </select>
        </div>
        <div class="mb-3 field-password pt-2">
            <label for="password">Password</label>
            <input type="password" name="password" id="password"
                   class="form-control form-control-sm"
                   required="required"
                   t-att-autofocus="'autofocus' if only_passwords else None"/>
        </div>
        <div class="mb-3 field-confirm_password">
            <label for="confirm_password">Confirm Password</label>
            <input type="password" name="confirm_password"
                   id="confirm_password"
                   class="form-control form-control-sm"
                   required="required"/>
        </div>

        <!-- Communication Preference -->
        <div class="mb-3 field-contact-pref">
            <label class="form-label fw-semibold" style="font-size:.9rem;">
                Preferred Contact Mode
            </label>
            <div class="d-flex gap-3 flex-wrap mt-1">
                <label class="contact-pref-option" style="display:flex;align-items:center;gap:8px;cursor:pointer;padding:8px 14px;border:1.5px solid #d1d5db;border-radius:10px;font-size:.88rem;transition:border-color .15s,background .15s;">
                    <input type="checkbox" name="comm_mode_call" value="1"
                           style="accent-color:#2563eb;width:16px;height:16px;"/>
                    <span>&#128222; Phone Call</span>
                </label>
                <label class="contact-pref-option" style="display:flex;align-items:center;gap:8px;cursor:pointer;padding:8px 14px;border:1.5px solid #d1d5db;border-radius:10px;font-size:.88rem;transition:border-color .15s,background .15s;">
                    <input type="checkbox" name="comm_mode_whatsapp" value="1"
                           style="accent-color:#2563eb;width:16px;height:16px;"/>
                    <span>&#128172; WhatsApp</span>
                </label>
                <label class="contact-pref-option" style="display:flex;align-items:center;gap:8px;cursor:pointer;padding:8px 14px;border:1.5px solid #d1d5db;border-radius:10px;font-size:.88rem;transition:border-color .15s,background .15s;">
                    <input type="checkbox" name="comm_mode_sms" value="1"
                           style="accent-color:#2563eb;width:16px;height:16px;"/>
                    <span>&#128241; SMS</span>
                </label>
            </div>
        </div>

        <!-- Hidden location inputs — filled by JS (IP / network / GPS) -->
        <input type="hidden" name="visitor_latitude" id="visitor_latitude" value=""/>
        <input type="hidden" name="visitor_longitude" id="visitor_longitude" value=""/>
        <input type="hidden" name="visitor_city" id="visitor_city" value=""/>
        <input type="hidden" name="visitor_location_source" id="visitor_location_source" value=""/>
    </template>
    <!--    Template for signup with mobile   -->
    <template id="signup_mobile" name="Sign up login">
        <t t-call="web.login_layout">
            <form class="oe_signup_form_mobile" role="form" method="post"
                  t-if="not message">
                <input type="hidden" name="csrf_token"
                       t-att-value="request.csrf_token()"/>
                <t t-call="signup_with_dibon_sms.signup_with_mobile_fields">
                    <t t-set="only_passwords"
                       t-value="bool(token and not invalid_token)"/>
                </t>
                <p class="alert alert-danger" t-if="error" role="alert">
                    <t t-esc="error"/>
                </p>
                <input type="hidden" name="redirect" t-att-value="redirect"/>
                <input type="hidden" name="token" t-att-value="token"/>
                <input type="hidden" name="signup_mobile" t-att-value="True"/>
                <div class="text-center oe_login_buttons d-grid pt-3">
                    <button type="submit" class="btn btn-primary sign-up">Sign
                        up
                    </button>
                    <a t-attf-href="/web/login?{{ keep_query() }}"
                       class="btn btn-link btn-sm" role="button">Already have an
                        account?
                    </a>
                    <div class="o_login_auth"/>
                </div>
            </form>
        </t>
    </template>
    <!--    Inherit the reset password template to add the mobile number-->
    <template id="sign_up_mobile_reset_password"
              inherit_id="auth_signup.reset_password"
              name="Reset password">
        <xpath expr="//div[@class='mb-3 field-login']/label"
               position="replace">
            <label for="login" class="col-form-label">Login Email/Mobile
                Number
            </label>
        </xpath>
        <xpath expr="//form[@class='oe_reset_password_form']/t[2]"
               position="after">
            <div class="check-login">
                <input type="checkbox" name="check-login" class="check_login">
                    <span>Mail as same as login</span>
                </input>
            </div>
            <t t-if="not token">
                <div class="mb-3 field-email">
                    <label for="login_mail" class="col-form-label">Mail to send
                        Password
                    </label>
                    <input type="text" name="login-mail"
                           t-att-value="login_mail"
                           id="login_mail" class="form-control"
                           autofocus="autofocus" required="required"
                           autocapitalize="off"/>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
