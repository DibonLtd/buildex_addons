<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'paymentlines')][t[@t-esc='line.name']]" position="replace">
            <div class="paymentlines text-start" t-foreach="props.data.paymentlines" t-as="line" t-key="line_index">
                <div>
                    <t t-esc="line.name" />
                    <span t-esc="props.formatCurrency(line.amount)" class="pos-receipt-right-align"/>
                </div>
                <t t-if="line.payment_ref_no">
                    <div class="pos-receipt-order-data">
                        Ref: <t t-esc="line.payment_ref_no"/>
                    </div>
                </t>
            </div>
        </xpath>
    </t>

</templates>
