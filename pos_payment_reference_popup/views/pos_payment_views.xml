<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_form_inherit_payment_reference_popup" model="ir.ui.view">
        <field name="name">pos.payment.form.inherit.payment.reference.popup</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_ref_no']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_pos_payment_tree_inherit_payment_reference_popup" model="ir.ui.view">
        <field name="name">pos.payment.list.inherit.payment.reference.popup</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="payment_ref_no" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_payment_search_inherit_payment_reference_popup" model="ir.ui.view">
        <field name="name">pos.payment.search.inherit.payment.reference.popup</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="payment_ref_no"/>
            </xpath>
        </field>
    </record>
</odoo>
