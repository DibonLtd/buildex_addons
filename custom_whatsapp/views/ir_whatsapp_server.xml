<?xml version="1.0" encoding="utf-8"?>
<odoo>
        
	    
        <record model="ir.ui.view" id="ir_whatsapp_server_form">
            <field name="model">ir.whatsapp_server</field>
            <field name="arch" type="xml">
                <form string="Whatsapp Servers">
                  <header>
                        <button name="action_get_qr_code" string="Get QR Code" type="object" 
                            class="btn-primary" icon="fa-qrcode"
                            invisible="connection_status == 'connected'"/>
                        <button name="action_check_connection" string="Check Connection" type="object" 
                            class="btn-primary" icon="fa-check-circle"/>
                        <button name="action_disconnect" string="Disconnect" type="object" 
                            class="btn-secondary" icon="fa-power-off"
                            invisible="connection_status == 'disconnected'"/>
                        <field name="connection_status" widget="statusbar"/>	
                  </header>
                  <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" class="oe_inline"/></h1>
                    </div>
                    <group>
                        <group string="Gateway Configuration">
                            <field name="gateway_url"/>
                            <field name="session_name"/>
                            <field name="client_secret"/>
                        </group>
                        <group string="WhatsApp Information">
                            <field name="whatsapp_number"/>
                            <field name="connection_status"/>
                        </group>
                     </group>
                     <group string="QR Code Scanner" invisible="connection_status == 'connected'">
                        <field name="qr_scan" widget="image" class="oe_avatar" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Allowed Users">
                            <field name="allowed_user_ids"/>
                        </page>
                        <page string="Channel Notification">
                            <field name="notify_user_ids"/>
                        </page>
                        <page string="API Response">
                            <group>
                                <field name="message_counts"/>
                                <field name="message_response"/>
                                <field name="whatsapp_token" readonly="1" force_save="1"/>
                            </group>
                        </page>
                    </notebook>
                  </sheet>  
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="ir_whatsapp_server_list">
            <field name="model">ir.whatsapp_server</field>
            <field name="arch" type="xml">
                <list string="Whatsapp Servers">
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="gateway_url"/>
                    <field name="session_name"/>
                    <field name="whatsapp_number"/>
                    <field name="connection_status"/>
                </list>
            </field>
        </record>
        <record id="view_ir_whatsapp_server_search" model="ir.ui.view">
            <field name="model">ir.whatsapp_server</field>
            <field name="arch" type="xml">
                <search string="Whatsapp Servers">
                    <field name="name"
                        filter_domain="[('name','ilike',self)]"
                        string="Whatsapp Server"/>
                </search>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_ir_whatsapp_server_list">
            <field name="name">Servers</field>
            <field name="res_model">ir.whatsapp_server</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="ir_whatsapp_server_list" />
            <field name="search_view_id" ref="view_ir_whatsapp_server_search"/>
        </record>
</odoo>
