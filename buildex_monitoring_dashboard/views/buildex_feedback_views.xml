<odoo>
    <record id="view_buildex_feedback_tree" model="ir.ui.view">
        <field name="name">buildex.feedback.tree</field>
        <field name="model">buildex.feedback</field>
        <field name="arch" type="xml">
            <list string="Feedback">
                <field name="name"/>
                <field name="feedback_date"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="fundi_id"/>
                <field name="product_satisfaction"/>
                <field name="fundi_satisfaction"/>
                <field name="would_recommend_buildex"/>
            </list>
        </field>
    </record>

    <record id="view_buildex_feedback_form" model="ir.ui.view">
        <field name="name">buildex.feedback.form</field>
        <field name="model">buildex.feedback</field>
        <field name="arch" type="xml">
            <form string="Buildex Feedback">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="feedback_date"/>
                            <field name="partner_id"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="sale_order_id"/>
                            <field name="invoice_id"/>
                            <field name="fundi_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="product_satisfaction"/>
                            <field name="fundi_satisfaction"/>
                            <field name="would_recommend_buildex"/>
                            <field name="followup_required"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Customer Need">
                            <field name="additional_need" nolabel="1" placeholder="What else does the customer need?"/>
                        </page>
                        <page string="Internal Notes">
                            <field name="notes" nolabel="1" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_buildex_feedback_search" model="ir.ui.view">
        <field name="name">buildex.feedback.search</field>
        <field name="model">buildex.feedback</field>
        <field name="arch" type="xml">
            <search string="Feedback">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="fundi_id"/>
                <filter name="recommend_yes" string="Would Recommend" domain="[('would_recommend_buildex', '=', 'yes')]"/>
                <filter name="recommend_no" string="Would Not Recommend" domain="[('would_recommend_buildex', '=', 'no')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_fundi" string="Fundi" context="{'group_by': 'fundi_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'feedback_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_buildex_feedback" model="ir.actions.act_window">
        <field name="name">Feedback</field>
        <field name="res_model">buildex.feedback</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_buildex_feedback_search"/>
    </record>
</odoo>
