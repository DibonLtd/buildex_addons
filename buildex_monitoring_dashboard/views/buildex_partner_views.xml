<odoo>
    <record id="view_partner_form_buildex_monitoring" model="ir.ui.view">
        <field name="name">res.partner.form.buildex.monitoring</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Buildex">
                    <group string="Customer Master">
                        <group>
                            <field name="phone"/>
                            <field name="buildex_alternative_phone"/>
                            <field name="gender"/>
                            <field name="buildex_age_bracket_id"/>
                            <field name="buildex_customer_type_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="county"/>
                            <field name="buildex_town"/>
                            <field name="buildex_area"/>
                            <field name="buildex_gps_pin"/>
                        </group>
                    </group>
                    <group string="Acquisition">
                        <group>
                            <field name="buildex_acquisition_source_id"/>
                            <field name="buildex_influencer_partner_id"/>
                            <field name="buildex_assigned_user_id"/>
                        </group>
                        <group>
                            <field name="buildex_next_expected_need_id"/>
                            <field name="buildex_acquisition_notes"/>
                        </group>
                    </group>
                    <group string="Monitoring">
                        <group>
                            <field name="buildex_last_activity_date" readonly="1"/>
                            <field name="buildex_pending_followup_count" readonly="1"/>
                            <field name="buildex_customer_health_score" readonly="1"/>
                            <field name="buildex_customer_health_segment" readonly="1"/>
                        </group>
                        <group>
                            <field name="buildex_at_risk" readonly="1"/>
                            <field name="buildex_high_value_customer" readonly="1"/>
                            <field name="buildex_one_time_buyer" readonly="1"/>
                            <field name="buildex_total_sales_amount" readonly="1"/>
                        </group>
                    </group>
                    <group string="Fundi Profile" invisible="not is_fundi">
                        <group>
                            <field name="is_fundi"/>
                            <field name="buildex_skill_type_ids" widget="many2many_tags"/>
                            <field name="buildex_years_experience"/>
                        </group>
                        <group>
                            <field name="buildex_jobs_linked_count" readonly="1"/>
                            <field name="buildex_projects_handled_count" readonly="1"/>
                            <field name="buildex_customer_rating_avg" readonly="1"/>
                            <field name="buildex_fundi_score" readonly="1"/>
                            <field name="buildex_fundi_rank" readonly="1"/>
                        </group>
                    </group>
                    <group string="Influencer Performance" invisible="not is_referrer">
                        <group>
                            <field name="buildex_referral_sale_count" readonly="1"/>
                            <field name="buildex_referral_revenue" readonly="1"/>
                        </group>
                        <group>
                            <field name="buildex_influencer_quality_score" readonly="1"/>
                            <field name="buildex_influencer_rank" readonly="1"/>
                        </group>
                    </group>
                    <group string="Projects">
                        <field name="buildex_project_ids" context="{'default_partner_id': id}">
                            <list editable="bottom">
                                <field name="code" readonly="1"/>
                                <field name="name"/>
                                <field name="project_type_id"/>
                                <field name="stage_id"/>
                                <field name="budget_range_id"/>
                            </list>
                        </field>
                    </group>
                    <group string="Follow-ups">
                        <field name="buildex_followup_ids" context="{'default_partner_id': id}">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="assigned_user_id"/>
                                <field name="next_expected_need_id"/>
                                <field name="due_date"/>
                                <field name="priority"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </group>
                    <group string="Fundi Requests">
                        <field name="buildex_fundi_request_ids" context="{'default_partner_id': id}">
                            <list>
                                <field name="name"/>
                                <field name="request_date"/>
                                <field name="assigned_user_id"/>
                                <field name="assigned_fundi_id"/>
                                <field name="action_point"/>
                                <field name="response_deadline"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </group>
                    <group string="Feedback">
                        <field name="buildex_feedback_ids" readonly="1">
                            <list>
                                <field name="feedback_date"/>
                                <field name="project_id"/>
                                <field name="product_satisfaction"/>
                                <field name="fundi_satisfaction"/>
                                <field name="would_recommend_buildex"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_buildex_monitoring" model="ir.ui.view">
        <field name="name">res.partner.search.buildex.monitoring</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="buildex_town"/>
                <field name="buildex_acquisition_source_id"/>
                <field name="buildex_customer_health_segment"/>
                <filter name="buildex_fundis" string="Fundis" domain="[('is_fundi', '=', True)]"/>
                <filter name="buildex_influencers" string="Influencers" domain="[('is_referrer', '=', True)]"/>
                <filter name="buildex_with_projects" string="With Projects" domain="[('buildex_project_ids', '!=', False)]"/>
                <filter name="buildex_at_risk" string="At Risk" domain="[('buildex_at_risk', '=', True)]"/>
                <filter name="buildex_high_value" string="High Value" domain="[('buildex_high_value_customer', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_buildex_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('customer_rank', '>', 0)]</field>
        <field name="context">{'search_default_buildex_with_projects': 1}</field>
    </record>

    <record id="action_buildex_fundis" model="ir.actions.act_window">
        <field name="name">Fundis</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_fundi', '=', True)]</field>
        <field name="context">{'default_is_fundi': True}</field>
    </record>
</odoo>
