<odoo>
    <record id="view_buildex_project_tree" model="ir.ui.view">
        <field name="name">buildex.project.tree</field>
        <field name="model">buildex.project</field>
        <field name="arch" type="xml">
            <list string="Projects">
                <field name="code"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_type_id"/>
                <field name="stage_id"/>
                <field name="assigned_user_id"/>
                <field name="next_expected_need_id"/>
                <field name="pending_followup_count"/>
                <field name="hot_lead"/>
                <field name="demand_signal"/>
                <field name="budget_range_id"/>
                <field name="start_date"/>
                <field name="expected_completion_date"/>
            </list>
        </field>
    </record>

    <record id="view_buildex_project_form" model="ir.ui.view">
        <field name="name">buildex.project.form</field>
        <field name="model">buildex.project</field>
        <field name="arch" type="xml">
            <form string="Buildex Project">
                <header>
                    <field name="stage_id" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Project Name"/>
                        </h1>
                        <div class="text-muted">
                            <field name="code" readonly="1"/>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="project_type_id"/>
                            <field name="residential_use_id" invisible="project_type_id.code != 'residential'"/>
                            <field name="stage_id"/>
                            <field name="assigned_user_id"/>
                            <field name="budget_range_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="expected_completion_date"/>
                            <field name="material_decision_maker_id"/>
                            <field name="fundi_id"/>
                            <field name="next_expected_need_id" readonly="1"/>
                            <field name="last_activity_date" readonly="1"/>
                            <field name="pending_followup_count" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" nolabel="1" placeholder="Project notes..."/>
                        </page>
                        <page string="Sales Orders">
                            <field name="sale_order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="state"/>
                                    <field name="amount_total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Feedback">
                            <field name="feedback_ids" readonly="1">
                                <list>
                                    <field name="feedback_date"/>
                                    <field name="partner_id"/>
                                    <field name="product_satisfaction"/>
                                    <field name="fundi_satisfaction"/>
                                    <field name="would_recommend_buildex"/>
                                </list>
                            </field>
                        </page>
                        <page string="Follow-ups">
                            <field name="followup_ids" context="{'default_project_id': id, 'default_partner_id': partner_id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="assigned_user_id"/>
                                    <field name="next_expected_need_id"/>
                                    <field name="due_date"/>
                                    <field name="priority"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_buildex_project_search" model="ir.ui.view">
        <field name="name">buildex.project.search</field>
        <field name="model">buildex.project</field>
        <field name="arch" type="xml">
            <search string="Projects">
                <field name="code"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="stage_id"/>
                <field name="project_type_id"/>
                <field name="assigned_user_id"/>
                <filter name="hot_leads" string="Hot Leads" domain="[('hot_lead', '=', True)]"/>
                <filter name="needs_followup" string="Needs Follow-up" domain="[('pending_followup_count', '&gt;', 0)]"/>
                <filter name="high_demand" string="High Demand" domain="[('demand_signal', '=', 'high')]"/>
                <filter name="stage_roofing" string="Roofing" domain="[('stage_id.code', '=', 'roofing')]"/>
                <filter name="high_budget" string="High Budget" domain="[('budget_range_id.code', '=', 'gt_1m')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'project_type_id'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_owner" string="Assigned To" context="{'group_by': 'assigned_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_buildex_projects" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">buildex.project</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_buildex_project_search"/>
    </record>
</odoo>
