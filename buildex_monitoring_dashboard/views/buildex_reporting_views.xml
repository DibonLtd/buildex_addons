<odoo>
    <record id="view_buildex_product_demand_report_pivot" model="ir.ui.view">
        <field name="name">buildex.product.demand.report.pivot</field>
        <field name="model">buildex.product.demand.report</field>
        <field name="arch" type="xml">
            <pivot string="Product Demand Insights">
                <field name="ordered_qty" type="measure"/>
                <field name="subtotal" type="measure"/>
                <field name="product_id" type="row"/>
                <field name="delivery_county" type="col"/>
                <field name="project_stage_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_buildex_product_demand_report_graph" model="ir.ui.view">
        <field name="name">buildex.product.demand.report.graph</field>
        <field name="model">buildex.product.demand.report</field>
        <field name="arch" type="xml">
            <graph string="Product Demand Insights" type="bar">
                <field name="product_id"/>
                <field name="delivery_county"/>
                <field name="ordered_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_buildex_product_demand_report_search" model="ir.ui.view">
        <field name="name">buildex.product.demand.report.search</field>
        <field name="model">buildex.product.demand.report</field>
        <field name="arch" type="xml">
            <search string="Product Demand Insights">
                <field name="product_id"/>
                <field name="project_stage_id"/>
                <field name="delivery_county"/>
                <field name="buildex_town"/>
                <field name="intended_use_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_county" string="County" context="{'group_by': 'delivery_county'}"/>
                    <filter name="group_stage" string="Project Stage" context="{'group_by': 'project_stage_id'}"/>
                    <filter name="group_use" string="Intended Use" context="{'group_by': 'intended_use_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_buildex_product_demand_insights" model="ir.actions.act_window">
        <field name="name">Product Demand Insights</field>
        <field name="res_model">buildex.product.demand.report</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="view_buildex_product_demand_report_search"/>
    </record>

    <record id="action_buildex_hot_leads" model="ir.actions.act_window">
        <field name="name">Hot Leads &amp; Active Projects</field>
        <field name="res_model">buildex.project</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_buildex_project_search"/>
        <field name="domain">['|', ('hot_lead', '=', True), ('stage_id.code', 'not in', ('paint_work', 'gardening'))]</field>
    </record>

    <record id="action_buildex_customer_health_segments" model="ir.actions.act_window">
        <field name="name">Customer Health Segments</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('customer_rank', '&gt;', 0)]</field>
        <field name="context">{'search_default_buildex_at_risk': 1}</field>
    </record>

    <record id="action_buildex_influencer_performance" model="ir.actions.act_window">
        <field name="name">Influencer Performance Live</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_referrer', '=', True)]</field>
    </record>

    <record id="action_buildex_fundi_network_activity" model="ir.actions.act_window">
        <field name="name">Fundi Network Activity</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_fundi', '=', True)]</field>
    </record>
</odoo>
