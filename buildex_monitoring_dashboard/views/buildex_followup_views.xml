<odoo>
    <record id="view_buildex_followup_tree" model="ir.ui.view">
        <field name="name">buildex.followup.tree</field>
        <field name="model">buildex.followup</field>
        <field name="arch" type="xml">
            <list string="Follow-ups">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="fundi_request_id"/>
                <field name="assigned_user_id"/>
                <field name="buildex_activity_type_id"/>
                <field name="next_expected_need_id"/>
                <field name="due_date"/>
                <field name="priority"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_buildex_followup_form" model="ir.ui.view">
        <field name="name">buildex.followup.form</field>
        <field name="model">buildex.followup</field>
        <field name="arch" type="xml">
            <form string="Buildex Follow-up">
                <header>
                    <button name="action_mark_in_progress" string="Start" type="object" class="oe_highlight" invisible="state != 'scheduled'"/>
                    <button name="action_mark_done" string="Mark Done" type="object" class="btn-primary" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_to_scheduled" string="Reset" type="object" invisible="state == 'scheduled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="project_id"/>
                            <field name="sale_order_id"/>
                            <field name="feedback_id"/>
                            <field name="fundi_request_id"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="buildex_activity_type_id"/>
                            <field name="next_expected_need_id"/>
                            <field name="priority"/>
                            <field name="due_date"/>
                            <field name="reminder_date"/>
                            <field name="completion_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" nolabel="1" placeholder="Next action notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_buildex_followup_search" model="ir.ui.view">
        <field name="name">buildex.followup.search</field>
        <field name="model">buildex.followup</field>
        <field name="arch" type="xml">
            <search string="Buildex Follow-ups">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="fundi_request_id"/>
                <field name="assigned_user_id"/>
                <field name="next_expected_need_id"/>
                <filter name="filter_overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="filter_pending" string="Pending" domain="[('state', 'not in', ('done', 'cancelled'))]"/>
                <filter name="filter_my_queue" string="My Queue" domain="[('assigned_user_id', '=', uid), ('state', 'not in', ('done', 'cancelled'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_owner" string="Assigned To" context="{'group_by': 'assigned_user_id'}"/>
                    <filter name="group_need" string="Next Need" context="{'group_by': 'next_expected_need_id'}"/>
                    <filter name="group_due_date" string="Due Date" context="{'group_by': 'due_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_buildex_followups" model="ir.actions.act_window">
        <field name="name">Follow-ups</field>
        <field name="res_model">buildex.followup</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_buildex_followup_search"/>
    </record>

    <record id="action_buildex_pending_followups" model="ir.actions.act_window">
        <field name="name">Pending Follow-ups</field>
        <field name="res_model">buildex.followup</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_buildex_followup_search"/>
        <field name="domain">[('state', 'not in', ('done', 'cancelled'))]</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>
</odoo>
