<odoo>
    <record id="view_order_form_buildex_monitoring" model="ir.ui.view">
        <field name="name">sale.order.form.buildex.monitoring</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <group string="Buildex Monitoring">
                    <field name="buildex_project_id"/>
                    <field name="buildex_outlet_location_id"/>
                    <field name="buildex_fundi_id"/>
                    <field name="buildex_followup_count" readonly="1"/>
                    <field name="buildex_last_activity_date" readonly="1"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="buildex_intended_use_id"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="after">
                <field name="buildex_intended_use_id"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Buildex Follow-ups">
                    <field name="buildex_followup_ids" context="{'default_sale_order_id': id, 'default_partner_id': partner_id, 'default_project_id': buildex_project_id}">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="assigned_user_id"/>
                            <field name="next_expected_need_id"/>
                            <field name="due_date"/>
                            <field name="priority"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
                <page string="Fundi Requests">
                    <field name="buildex_fundi_request_ids" context="{'default_sale_order_id': id, 'default_partner_id': partner_id}">
                        <list editable="bottom">
                            <field name="name" readonly="1"/>
                            <field name="request_date"/>
                            <field name="assigned_user_id"/>
                            <field name="assigned_fundi_id"/>
                            <field name="action_point"/>
                            <field name="response_deadline"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_filter_buildex_monitoring" model="ir.ui.view">
        <field name="name">sale.order.search.buildex.monitoring</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="buildex_project_id"/>
                <field name="buildex_outlet_location_id"/>
                <field name="buildex_fundi_id"/>
                <filter name="missing_buildex_project" string="Missing Project" domain="[('buildex_project_id', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_buildex_project" string="Buildex Project" context="{'group_by': 'buildex_project_id'}"/>
                    <filter name="group_buildex_outlet" string="Outlet" context="{'group_by': 'buildex_outlet_location_id'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
