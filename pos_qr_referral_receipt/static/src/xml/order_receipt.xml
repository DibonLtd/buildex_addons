<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[@class='after-footer']" position="before">
            <t t-if="props.data.headerData.company.pos_shop_referral_qr">
                <div class="pos-receipt-order-data mt-3 mb-1">
                    Shop QR Code
                </div>
                <div class="text-center mb-2">
                    <img
                        t-att-src="'data:image/png;base64,' + props.data.headerData.company.pos_shop_referral_qr"
                        style="max-width: 180px; max-height: 180px;"
                    />
                </div>
            </t>
        </xpath>
    </t>

</templates>
