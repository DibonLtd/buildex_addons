<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_customer_risk_blacklist" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.customer.risk.blacklist</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[field[@name='account_use_credit_limit']]" position="after">
                <setting
                    id="customer_bounced_cheque_blacklist_limit"
                    help="Customers are blacklisted for credit sales once their bounced cheque count exceeds this limit.">
                    <field name="bounced_cheque_blacklist_limit"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
