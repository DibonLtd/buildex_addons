<odoo>
    <record id="view_influencer_link_performance_tree" model="ir.ui.view">
        <field name="name">influencer.link.performance.report.tree</field>
        <field name="model">influencer.link.performance.report</field>
        <field name="arch" type="xml">
            <list string="Influencer Link Performance" create="false" edit="false" delete="false">
                <field name="partner_id"/>
                <field name="referral_code"/>
                <field name="referral_url" widget="url"/>
                <field name="visit_count"/>
                <field name="order_count"/>
                <field name="conversion_rate"/>
            </list>
        </field>
    </record>

    <record id="view_influencer_link_performance_pivot" model="ir.ui.view">
        <field name="name">influencer.link.performance.report.pivot</field>
        <field name="model">influencer.link.performance.report</field>
        <field name="arch" type="xml">
            <pivot string="Influencer Link Performance">
                <field name="partner_id" type="row"/>
                <field name="visit_count" type="measure"/>
                <field name="order_count" type="measure"/>
                <field name="conversion_rate" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_influencer_link_performance_graph" model="ir.ui.view">
        <field name="name">influencer.link.performance.report.graph</field>
        <field name="model">influencer.link.performance.report</field>
        <field name="arch" type="xml">
            <graph string="Influencer Link Performance" type="bar">
                <field name="partner_id"/>
                <field name="visit_count"/>
                <field name="order_count"/>
            </graph>
        </field>
    </record>

    <record id="view_influencer_link_performance_search" model="ir.ui.view">
        <field name="name">influencer.link.performance.report.search</field>
        <field name="model">influencer.link.performance.report</field>
        <field name="arch" type="xml">
            <search string="Influencer Link Performance">
                <field name="partner_id"/>
                <field name="referral_code"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_partner" string="Influencer" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_influencer_link_performance" model="ir.actions.act_window">
        <field name="name">Influencer Link Performance</field>
        <field name="res_model">influencer.link.performance.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_influencer_link_performance_search"/>
    </record>

    <menuitem id="menu_influencer_link_performance"
              name="Link Performance"
              parent="menu_influencer_root"
              action="action_influencer_link_performance"
              sequence="50"/>
</odoo>
