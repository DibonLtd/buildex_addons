<odoo>

    <!-- ========================= Tree ========================= -->
    <record id="view_influencer_wallet_tree" model="ir.ui.view">
        <field name="name">influencer.wallet.tree</field>
        <field name="model">influencer.wallet.transaction</field>
        <field name="arch" type="xml">
            <list string="Wallet Transactions">
                <field name="partner_id"/>
                <field name="transaction_type"/>
                <field name="amount"/>
                <field name="commission_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- ========================= Form ========================= -->
    <record id="view_influencer_wallet_form" model="ir.ui.view">
        <field name="name">influencer.wallet.form</field>
        <field name="model">influencer.wallet.transaction</field>
        <field name="arch" type="xml">
            <form string="Wallet Transaction">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="transaction_type"/>
                        <field name="amount"/>
                        <field name="commission_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================= Action ========================= -->
    <record id="action_influencer_wallet" model="ir.actions.act_window">
        <field name="name">Influencer Wallet</field>
        <field name="res_model">influencer.wallet.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ========================= Menu ========================= -->
    <menuitem id="menu_influencer_wallet"
              name="Influencer Wallet"
              parent="menu_influencer_sales_main"
              sequence="52"
              action="action_influencer_wallet"/>

</odoo>
