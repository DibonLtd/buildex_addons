<odoo>
    <record id="qr_referral_points_product_template_form" model="ir.ui.view">
        <field name="name">product.template.form.qr.referral.points</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="influencer_commission_rate" string="Influencer Commission Rate (%)"/>
            </xpath>
        </field>
    </record>
</odoo>
