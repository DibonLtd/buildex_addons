<odoo>

    <record id="view_influencer_commission_plan_tree" model="ir.ui.view">
        <field name="name">influencer.commission.plan.tree</field>
        <field name="model">influencer.commission.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field  name="auto_payout_enabled"/>
                <field  name="auto_payout_minimum"/>

                
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_influencer_commission_plan_form" model="ir.ui.view">
        <field name="name">influencer.commission.plan.form</field>
        <field name="model">influencer.commission.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field  name="default_rate"/>
                        <field  name="auto_payout_enabled"/>
                        <field  name="auto_payout_minimum"/>
                        
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Rules">
                            <field name="rule_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_influencer_commission_plan" model="ir.actions.act_window">
        <field name="name">Commission Plans</field>
        <field name="res_model">influencer.commission.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_influencer_commission_plan"
              name="Commission Plans"
              parent="menu_influencer_sales_main"
              sequence="60"
              action="action_influencer_commission_plan"/>

</odoo>
