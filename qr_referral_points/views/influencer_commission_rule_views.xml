<odoo>

    <record id="view_influencer_commission_rule_tree" model="ir.ui.view">
        <field name="name">influencer.commission.rule.tree</field>
        <field name="model">influencer.commission.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="plan_id"/>
                <field name="categ_id"/>
                <field name="rate"/>
            </list>
        </field>
    </record>

    <record id="view_influencer_commission_rule_form" model="ir.ui.view">
        <field name="name">influencer.commission.rule.form</field>
        <field name="model">influencer.commission.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="plan_id"/>
                        <field name="categ_id"/>
                        <field name="rate"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_influencer_commission_rule" model="ir.actions.act_window">
        <field name="name">Commission Rules</field>
        <field name="res_model">influencer.commission.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_influencer_commission_rule"
              name="Commission Rules"
              parent="menu_influencer_sales_main"
              sequence="61"
              action="action_influencer_commission_rule"/>

</odoo>
