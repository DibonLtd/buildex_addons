<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         COMMISSION PLAN
    ═══════════════════════════════════════════════════════════ -->
    <record id="ip_view_commission_plan_list" model="ir.ui.view">
        <field name="name">ip.commission.plan.list</field>
        <field name="model">influencer.commission.plan</field>
        <field name="arch" type="xml">
            <list string="Commission Plans">
                <field name="name"/>
                <field name="default_rate" string="Default Rate (%)"/>
                <field name="topline_bonus_rate" string="Topline Bonus (%)"/>
                <field name="withholding_tax_rate" string="WHT (%)"/>
                <field name="auto_payout_enabled" string="Auto Payout"/>
                <field name="auto_payout_minimum" string="Min Payout"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="ip_view_commission_plan_form" model="ir.ui.view">
        <field name="name">ip.commission.plan.form</field>
        <field name="model">influencer.commission.plan</field>
        <field name="arch" type="xml">
            <form string="Commission Plan">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Plan Name"/></h1>
                    </div>
                    <group>
                        <group string="Commission Rates">
                            <field name="default_rate" string="Default Commission (%)"/>
                            <field name="topline_bonus_rate" string="Topline Bonus (%)"/>
                            <field name="withholding_tax_rate" string="Withholding Tax (%)"/>
                        </group>
                        <group string="Auto Payout">
                            <field name="auto_payout_enabled"/>
                            <field name="auto_payout_minimum"
                                   invisible="not auto_payout_enabled"/>
                            <field name="currency_id" invisible="not auto_payout_enabled"/>
                        </group>
                    </group>
                    <field name="rule_ids">
                        <list editable="bottom" string="Category-Specific Rates">
                            <field name="categ_id" string="Product Category"/>
                            <field name="rate" string="Commission Rate (%)"/>
                        </list>
                    </field>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ip_action_commission_plans" model="ir.actions.act_window">
        <field name="name">Commission Plans</field>
        <field name="res_model">influencer.commission.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         PROGRAMME CONFIG (Terms & Conditions)
    ═══════════════════════════════════════════════════════════ -->
    <record id="ip_view_program_config_form" model="ir.ui.view">
        <field name="name">ip.program.config.form</field>
        <field name="model">influencer.program.config</field>
        <field name="arch" type="xml">
            <form string="Programme Terms">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <field name="terms_html" widget="html"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ip_view_program_config_list" model="ir.ui.view">
        <field name="name">ip.program.config.list</field>
        <field name="model">influencer.program.config</field>
        <field name="arch" type="xml">
            <list string="Programme Configuration">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="ip_action_program_config" model="ir.actions.act_window">
        <field name="name">Programme Terms</field>
        <field name="res_model">influencer.program.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
