<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         REFERRED SALES — list view
    ═══════════════════════════════════════════════════════════ -->
    <record id="ip_view_referred_sales_list" model="ir.ui.view">
        <field name="name">ip.referred.sales.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Referred Sales"
                  decoration-success="influencer_order_stage == 'paid'"
                  decoration-info="influencer_order_stage == 'invoiced'"
                  decoration-warning="influencer_order_stage == 'dispatched'"
                  decoration-muted="influencer_order_stage == 'delivered'">
                <field name="name" string="Order"/>
                <field name="date_order" string="Date"/>
                <field name="partner_id" string="Customer"/>
                <field name="referral_partner_id" string="Influencer"/>
                <field name="referral_code" string="Ref Code"/>
                <field name="amount_total" string="Total (KES)" sum="Grand Total"/>
                <field name="influencer_order_stage" widget="badge"
                       decoration-success="influencer_order_stage == 'paid'"
                       decoration-info="influencer_order_stage == 'invoiced'"
                       decoration-warning="influencer_order_stage == 'dispatched'"
                       decoration-primary="influencer_order_stage == 'ordered'"/>
                <field name="state" string="Order State"/>
            </list>
        </field>
    </record>

    <record id="ip_view_referred_sales_graph" model="ir.ui.view">
        <field name="name">ip.referred.sales.graph</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <graph string="Referred Sales" type="bar">
                <field name="referral_partner_id" type="row"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="ip_view_referred_sales_pivot" model="ir.ui.view">
        <field name="name">ip.referred.sales.pivot</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <pivot string="Referred Sales">
                <field name="referral_partner_id" type="row"/>
                <field name="date_order" type="col" interval="month"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="ip_view_referred_sales_search" model="ir.ui.view">
        <field name="name">ip.referred.sales.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Referred Sales">
                <field name="name" string="Order"/>
                <field name="partner_id" string="Customer"/>
                <field name="referral_partner_id" string="Influencer"/>
                <field name="referral_code"/>
                <separator/>
                <filter name="stage_ordered" string="Ordered"
                        domain="[('influencer_order_stage','=','ordered')]"/>
                <filter name="stage_dispatched" string="Dispatched"
                        domain="[('influencer_order_stage','=','dispatched')]"/>
                <filter name="stage_delivered" string="Delivered"
                        domain="[('influencer_order_stage','=','delivered')]"/>
                <filter name="stage_invoiced" string="Invoiced"
                        domain="[('influencer_order_stage','=','invoiced')]"/>
                <filter name="stage_paid" string="Paid"
                        domain="[('influencer_order_stage','=','paid')]"/>
                <separator/>
                <group string="Group By">
                    <filter string="Influencer" name="group_influencer"
                            context="{'group_by':'referral_partner_id'}"/>
                    <filter string="Stage" name="group_stage"
                            context="{'group_by':'influencer_order_stage'}"/>
                    <filter string="Month" name="group_month"
                            context="{'group_by':'date_order:month'}"/>
                    <filter string="Customer" name="group_customer"
                            context="{'group_by':'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ip_action_referred_sales" model="ir.actions.act_window">
        <field name="name">Referred Sales</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,graph,pivot,form</field>
        <field name="domain">[('is_referral_order','=',True)]</field>
        <field name="search_view_id" ref="ip_view_referred_sales_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('ip_view_referred_sales_list')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('ip_view_referred_sales_graph')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('ip_view_referred_sales_pivot')}),
        ]"/>
    </record>

</odoo>
